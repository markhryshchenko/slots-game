# Copy to .env and fill in real values. .env is local only (gitignored).

PORT=3000

# HS256 secret for API session tokens, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_JWT_SECRET=
SESSION_TTL_SECONDS=3600

# Centrifugo — real-time balance (docker compose up -d centrifugo).
# CENTRIFUGO_TOKEN_SECRET signs client connection tokens; it must differ from
# SESSION_JWT_SECRET. All four secrets: at least 32 characters.
CENTRIFUGO_TOKEN_SECRET=
CENTRIFUGO_API_KEY=
CENTRIFUGO_ADMIN_PASSWORD=
CENTRIFUGO_ADMIN_SECRET=
CENTRIFUGO_API_URL=http://localhost:9000/api
CENTRIFUGO_WS_URL=ws://localhost:9000/connection/websocket
# Connection token lifetime; clients renew it via POST /v1/realtime/token.
# Short on purpose: it bounds how long a copied token works after logout.
CENTRIFUGO_TOKEN_TTL_SECONDS=300

# Demo operator "democustomer": accepts ANY launch token and gives every new
# player free balance. Local development and tests only — never "true" in
# production. Anything other than "true" keeps it disabled.
DEMO_OPERATOR_ENABLED=true

# Redis — Centrifugo engine and API sessions (docker compose up -d redis).
# Hex only (it goes into URLs), at least 32 characters; same value in both lines.
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# Postgres — wallet, ledger and outbox (docker compose up -d postgres).
# Use the same password in both lines.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://slots:<POSTGRES_PASSWORD>@localhost:5432/slots
