# Copy to .env and fill in real values. .env is local only (gitignored).

PORT=3000

# HS256 secret for API session tokens, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_JWT_SECRET=
SESSION_TTL_SECONDS=3600

# Centrifugo — real-time balance (docker compose up -d centrifugo).
# CENTRIFUGO_TOKEN_SECRET signs client connection tokens; it must differ from
# SESSION_JWT_SECRET. All four secrets: at least 32 characters.
CENTRIFUGO_TOKEN_SECRET=
CENTRIFUGO_API_KEY=
CENTRIFUGO_ADMIN_PASSWORD=
CENTRIFUGO_ADMIN_SECRET=
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
