{
  "name": "cardano-play",
  "version": "1.0.0",
  "private": true,
  "description": "Cardano Play slot platform: game server and game clients (npm workspaces)",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cardano-play/server",
    "dev:client": "npm run dev -w @cardano-play/slots-client",
    "start": "npm run start -w @cardano-play/server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "sandbox": "npm run sandbox -w @cardano-play/server",
    "watch:balance": "npm run watch:balance -w @cardano-play/server",
    "db:generate": "npm run db:generate -w @cardano-play/server",
    "db:migrate": "npm run db:migrate -w @cardano-play/server --",
    "db:deploy": "npm run db:deploy -w @cardano-play/server"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs": false,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true
  }
}
